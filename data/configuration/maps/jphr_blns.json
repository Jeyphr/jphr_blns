        "rounds":
        {
            "position_style": "bottom_left",
            "skip_intro": false,
            "use_tally_marks_until_round": 0,
            "color": [220, 220, 0]
        },

        "equipment":
        {
            "graphics":
            {
                "grenade":          "gfx/hud/jphr/blns/equipment/frag"
