        },

        "score":
        {
            "position_style": "right",

            "graphics":
            {
                "score_background_full":        "gfx/hud/jphr/blns/score/moneybackYlw",
                "score_background_condensed":   "gfx/hud/jphr/blns/score/moneyback_condensedGrn"
            }
        }
    }
}