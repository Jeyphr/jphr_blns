    "interface":
    {
        "perksacola":
        {
            "position_style": "bo3",

            "graphics":
            {
                "quickrevive":  "gfx/hud/jphr/blns/perks/revive",
                "juggernog":    "gfx/hud/jphr/blns/perks/jug",
                "speedcola":    "gfx/hud/jphr/blns/perks/speed",
                "doubletap":    "gfx/hud/jphr/blns/perks/double",
                "doubletap_2":  "gfx/hud/jphr/blns/perks/double2",
                "staminup":     "gfx/hud/jphr/blns/perks/stamin",
                "flopper":      "gfx/hud/jphr/blns/perks/flopper",
                "deadshot":     "gfx/hud/jphr/blns/perks/dead",
                "mulekick":     "gfx/hud/jphr/blns/perks/mule"
            }
